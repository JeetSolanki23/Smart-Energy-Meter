APP_NAME=Smart Energy Meter Backend
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:8080
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_meter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PAIR_CODE_TTL_SECONDS=600
DEVICE_DATA_INTERVAL_SECONDS=60
PRICE_PER_UNIT=7.0
MIN_PAYMENT_AMOUNT=1.0

# Email notifications (tamper + payment)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME=Smart Energy Meter
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
# Optional additional recipients for tamper alerts (comma-separated)
ALERT_EMAIL_TO=admin@example.com
